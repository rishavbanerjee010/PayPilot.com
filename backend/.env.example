# ---------------------------------------------------------------------------
# PayPilot backend configuration
# Copy this file to .env and fill in your own credentials.
#   (PowerShell)  Copy-Item .env.example .env
#   (macOS/Linux) cp .env.example .env
# NEVER commit .env to git (it is already in .gitignore).
# ---------------------------------------------------------------------------

# --- OpenAI (required for the AI assistant) -------------------------------
# Paid option: get a key at https://platform.openai.com/api-keys
# FREE option (no credit card): https://console.groq.com -> API Keys, then set:
#   OPENAI_API_KEY=gsk_...            (your free Groq key)
#   OPENAI_MODEL=openai/gpt-oss-120b
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1/
OPENAI_API_KEY=
# Any model that supports the Responses API + function calling
OPENAI_MODEL=gpt-4o-mini
# Optional: override the OpenAI base URL (e.g. Groq's free endpoint above, or
# any OpenAI-compatible provider). Leave empty to use https://api.openai.com/v1
OPENAI_BASE_URL=

# --- PayPal (required for checkout) ---------------------------------------
# 1. Sign in at https://developer.paypal.com/dashboard
# 2. Apps & Credentials -> SANDBOX -> "Create App" -> copy Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox REST host (use https://api-m.paypal.com for live — NOT for this demo)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Currency -------------------------------------------------------------
# PayPilot's store currency is INR (all catalogue prices, cart totals, AI and
# the database are INR).
#
# IMPORTANT: PayPal's REST API does NOT support INR (INR is absent from
# https://developer.paypal.com/api/nvp-soap/currency-codes and PayPal ended
# domestic payments in India on 1 Apr 2021). With PAYPAL_CURRENCY=INR the
# checkout will attempt INR and PayPal will reject it; PayPilot then shows a
# clear explanation instead of silently converting.
#
# To complete a PayPal SANDBOX demo transaction, set this to a supported
# currency, e.g. USD. The catalogue/cart stay in INR; the Sandbox order is
# created for the same numeric total in that currency (Sandbox money only).
# For real INR payments you would integrate Razorpay/Cashfree/PayU instead.
PAYPAL_CURRENCY=INR

# --- Optional --------------------------------------------------------------
# Where the SQLite database file is stored (default: backend/paypilot.db)
# PAYPILOT_DB_PATH=
